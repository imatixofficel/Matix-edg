    <string name="mx_tour_welcome_body">A short tour shows where everything is. You only see it the first time.</string>
    <string name="mx_tour_connect_title">Connect button</string>
    <string name="mx_tour_connect_body">One tap connects to the selected config, another tap disconnects.</string>
    <string name="mx_tour_sections_title">Two main sections</string>
